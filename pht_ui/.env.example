# Copy this to paper_annotation/.env and fill in your keys.
# The server reads .env from the paper_annotation directory, not from pht_ui.

OPENAI_API_KEY=sk-...
GEMINI_API_KEY=...
GROQ_API_KEY=gsk_...
MISTRAL_API_KEY=...
# HF_TOKEN=hf_...   # only for the legacy HuggingFace provider

# Optional - override pipeline location (default: ../paper_annotation in this repo)
# PIPELINE_ROOT=/absolute/path/to/paper_annotation

# Opt-in providers (not run by default)
# ANTHROPIC_API_KEY=sk-ant-...            # python main.py --model claude   (sonnet-5-5, opus-5-5, haiku-5-5)
# ANTHROPIC_EFFORT=medium                 # low|medium|high|xhigh|max (cost/quality lever)
# COMPAT_BASE_URL=https://openrouter.ai/api/v1
# COMPAT_API_KEY=...
# COMPAT_MODELS=google/gemma-3-27b-it,meta-llama/llama-4-maverick   # python main.py --model compat
